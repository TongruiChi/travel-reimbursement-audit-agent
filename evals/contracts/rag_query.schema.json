{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/evals/contracts/rag-query-v1.schema.json",
  "title": "RAG Evaluation Query v1",
  "description": "Review-first contract for one policy retrieval query.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_id",
    "description",
    "tags",
    "policy",
    "input",
    "label"
  ],
  "properties": {
    "schema_version": {
      "const": "rag_query.v1"
    },
    "query_id": {
      "type": "string",
      "pattern": "^RAG-PILOT-[0-9]{3}$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policy": {
      "$ref": "#/$defs/policyRef"
    },
    "input": {
      "$ref": "#/$defs/ragInput"
    },
    "label": {
      "$ref": "#/$defs/ragLabel"
    }
  },
  "$defs": {
    "policyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version"],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ragInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "top_k"],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "top_k": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "candidateExpected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_rule_id", "relevant_rule_ids"],
      "properties": {
        "primary_rule_id": {
          "type": ["string", "null"]
        },
        "relevant_rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ragLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "candidate_expected",
        "reviewer",
        "reviewed_at",
        "review_notes"
      ],
      "properties": {
        "status": {
          "const": "APPROVED"
        },
        "candidate_expected": {
          "$ref": "#/$defs/candidateExpected"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
