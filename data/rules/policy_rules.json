{
  "policy_id": "company-travel-reimbursement",
  "policy_version": "1.0.0",
  "effective_date": null,
  "currency": "CNY",
  "rules": [
    {
      "rule_id": "R-GEN-001",
      "category": ["ALL"],
      "title": "出差期间消费规则",
      "description": "消费日期必须在出差开始日期和出差结束日期之间。",
      "enforcement": "ENFORCED",
      "severity": "high",
      "evaluator": "expense_date_within_trip",
      "keywords": ["出差期间", "消费日期", "行程日期", "日期异常", "人工复核"],
      "flag": "EXPENSE_OUT_OF_TRIP_DATE",
      "violation_message": "消费日期不在出差期间内，需人工复核。",
      "threshold": null,
      "applicable_cities": null,
      "evaluable_categories": null
    },
    {
      "rule_id": "R-GEN-002",
      "category": ["ALL"],
      "title": "凭证必需规则",
      "description": "每笔报销费用原则上必须提供发票、电子发票、支付凭证或其他可验证凭证。当前系统只能可靠判断凭证记录是否存在。",
      "enforcement": "PARTIAL",
      "severity": "high",
      "evaluator": "receipt_presence",
      "keywords": ["凭证", "发票", "电子发票", "支付凭证", "缺失", "报销凭证"],
      "flag": "RECEIPT_MISSING",
      "violation_message": "该笔费用缺少报销凭证。",
      "threshold": null,
      "applicable_cities": null,
      "evaluable_categories": null
    },
    {
      "rule_id": "R-GEN-003",
      "category": ["ALL"],
      "title": "金额必须大于零",
      "description": "报销金额必须为正数。",
      "enforcement": "ENFORCED",
      "severity": "high",
      "evaluator": "positive_amount",
      "keywords": ["金额", "正数", "无效金额", "报销金额"],
      "flag": "INVALID_AMOUNT",
      "violation_message": "报销金额必须大于 0。",
      "threshold": {
        "amount": 0,
        "comparison": "GT",
        "basis": "PER_EXPENSE"
      },
      "applicable_cities": null,
      "evaluable_categories": null
    },
    {
      "rule_id": "R-TRAFFIC-001",
      "category": ["交通"],
      "title": "城际交通规则",
      "description": "高铁、火车、飞机、长途客运等城际交通费用可报销，但费用说明需要与出差行程相关。",
      "enforcement": "EVIDENCE_ONLY",
      "severity": null,
      "evaluator": null,
      "keywords": ["交通", "城际交通", "高铁", "火车", "飞机", "机票", "长途客运", "出差行程"],
      "flag": "TRAFFIC_PURPOSE_UNCLEAR",
      "violation_message": "交通费用用途不明确，需人工复核。",
      "threshold": null,
      "applicable_cities": null,
      "evaluable_categories": null
    },
    {
      "rule_id": "R-TRAFFIC-002",
      "category": ["交通", "市内出行"],
      "title": "市内出行规则",
      "description": "出差期间发生的出租车、网约车、地铁等市内出行费用可报销，单笔金额原则上不超过政策定义的市内出行上限。笼统的交通类别不能自动视为市内出行。",
      "enforcement": "PARTIAL",
      "severity": "medium",
      "evaluator": "amount_threshold",
      "keywords": ["交通", "市内出行", "出租车", "网约车", "地铁", "金额", "出差期间"],
      "flag": "LOCAL_TRAFFIC_AMOUNT_HIGH",
      "violation_message": "单笔市内出行费用金额较高，需人工复核。",
      "threshold": {
        "amount": 300,
        "comparison": "LTE",
        "basis": "PER_EXPENSE"
      },
      "applicable_cities": null,
      "evaluable_categories": ["市内出行"]
    },
    {
      "rule_id": "R-HOTEL-001",
      "category": ["住宿"],
      "title": "住宿费用上限规则",
      "description": "一线和新一线城市住宿费用原则上不超过政策定义的每晚上限。当前费用数据缺少住宿晚数和费用发生城市，不能直接以整笔金额认定违规。",
      "enforcement": "PARTIAL",
      "severity": "medium",
      "evaluator": "amount_threshold",
      "keywords": ["住宿", "酒店", "金额", "每晚", "超标"],
      "flag": "HOTEL_AMOUNT_EXCEED_LIMIT",
      "violation_message": "住宿费用超过公司标准，需补充审批说明。",
      "threshold": {
        "amount": 800,
        "comparison": "LTE",
        "basis": "PER_NIGHT"
      },
      "applicable_cities": ["北京", "上海", "广州", "深圳", "杭州", "南京", "苏州", "成都", "重庆", "武汉", "西安", "天津"],
      "evaluable_categories": null
    },
    {
      "rule_id": "R-HOTEL-002",
      "category": ["住宿"],
      "title": "住宿凭证规则",
      "description": "住宿费用必须提供酒店发票或住宿服务类电子发票，且凭证销售方或说明中应能体现住宿服务。当前系统只能可靠判断凭证记录是否存在。",
      "enforcement": "PARTIAL",
      "severity": null,
      "evaluator": "receipt_presence",
      "keywords": ["住宿", "酒店发票", "电子发票", "凭证类型", "销售方", "宾馆", "公寓"],
      "flag": "HOTEL_RECEIPT_INVALID",
      "violation_message": "住宿凭证类型或销售方信息不明确。",
      "threshold": null,
      "applicable_cities": null,
      "evaluable_categories": null
    },
    {
      "rule_id": "R-MEAL-001",
      "category": ["餐饮"],
      "title": "餐饮费用上限规则",
      "description": "出差期间餐饮费用可按实际发生报销，但单笔餐饮费用原则上不超过政策定义的餐饮上限。",
      "enforcement": "ENFORCED",
      "severity": "medium",
      "evaluator": "amount_threshold",
      "keywords": ["餐饮", "工作餐", "金额", "超标", "单笔"],
      "flag": "MEAL_AMOUNT_EXCEED_LIMIT",
      "violation_message": "单笔餐饮费用超过标准，需人工复核。",
      "threshold": {
        "amount": 150,
        "comparison": "LTE",
        "basis": "PER_EXPENSE"
      },
      "applicable_cities": null,
      "evaluable_categories": null
    },
    {
      "rule_id": "R-MEAL-002",
      "category": ["餐饮"],
      "title": "餐饮凭证规则",
      "description": "餐饮费用应提供有效发票或支付凭证。当前系统只能可靠判断凭证记录是否存在。",
      "enforcement": "PARTIAL",
      "severity": null,
      "evaluator": "receipt_presence",
      "keywords": ["餐饮", "发票", "支付凭证", "有效凭证", "凭证缺失"],
      "flag": "MEAL_RECEIPT_MISSING",
      "violation_message": "餐饮费用缺少凭证。",
      "threshold": null,
      "applicable_cities": null,
      "evaluable_categories": null
    },
    {
      "rule_id": "R-OTHER-001",
      "category": ["其他"],
      "title": "其他费用人工复核规则",
      "description": "无法明确归类为交通、住宿、餐饮、市内出行的费用应进入人工复核，费用说明需清楚且与出差任务直接相关。",
      "enforcement": "PARTIAL",
      "severity": "low",
      "evaluator": "manual_review",
      "keywords": ["其他", "费用说明", "人工复核", "出差任务", "凭证"],
      "flag": "OTHER_EXPENSE_NEED_REVIEW",
      "violation_message": "其他费用需人工确认是否与出差相关。",
      "threshold": null,
      "applicable_cities": null,
      "evaluable_categories": null
    }
  ]
}
